{
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "lib": ["ES2021", "DOM"],
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ES2021",
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*"]
}
