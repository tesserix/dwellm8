{
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "lib": ["ES2021", "DOM"],
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ES2021",
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    // TS7 no longer walks up to the workspace root's @types on its own.
    "types": ["jest", "node"]
  },
  "include": ["src/**/*"]
}
