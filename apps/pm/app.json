{
  "expo": {
    "name": "Dwellm8 PM",
    "slug": "dwellm8-pm",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "dwellm8pm",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#EAF2FA",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.dwellm8.pm",
      "entitlements": {
        "keychain-access-groups": ["$(AppIdentifierPrefix)app.dwellm8.pm"]
      }
    },
    "android": {
      "package": "app.dwellm8.pm"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Dwellm8 uses your photos only to read an identity document you choose.",
          "cameraPermission": "Dwellm8 uses the camera to read an owner's PAN card or passport, so you do not type it."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
