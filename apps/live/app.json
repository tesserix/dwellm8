{
  "expo": {
    "name": "Dwellm8 Live",
    "slug": "dwellm8-live",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "Dwellm8",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": { "backgroundColor": "#EAF2FA", "resizeMode": "contain" },
    "ios": { "supportsTablet": true, "bundleIdentifier": "app.dwellm8.live" },
    "android": { "package": "app.dwellm8.live" },
    "web": { "bundler": "metro", "output": "single" },
    "plugins": ["expo-router"],
    "experiments": { "typedRoutes": true }
  }
}
